import { caThemePlugin } from "@codeatlasdev/ui/vite";
import adapter from "@sveltejs/adapter-static";
import { sveltekit } from "@sveltejs/kit/vite";
import { defineConfig } from "vite";

// Tauri loads the built files (frontendDist) and, in dev, this server (devUrl in crates/desktop/tauri.conf.json).
export default defineConfig({
	plugins: [
		caThemePlugin(),
		sveltekit({ adapter: adapter({ fallback: "index.html" }) }),
	],
	clearScreen: false,
	// atlas injects PORT; strictPort fails loudly instead of drifting to a port Tauri does not know.
	server: {
		host: "127.0.0.1",
		port: Number(process.env.PORT) || {{port "desktop"}},
		strictPort: true,
	},
});
