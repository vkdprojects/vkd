{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": {{quote .Name}},
	"version": "0.1.0",
	"identifier": {{quote (printf "com.%s.%s" (lower .Owner) (lower (replace "-" "" .Name)))}},
	"build": {
		"frontendDist": "../../apps/desktop/build",
		"devUrl": "http://localhost:{{port "desktop"}}",
		"beforeDevCommand": "bun run --cwd ../apps/desktop dev",
		"beforeBuildCommand": "bun run --cwd ../apps/desktop build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": {{quote .Name}},
				"width": 1100,
				"height": 720,
				"minWidth": 720,
				"minHeight": 480
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"shortDescription": {{quote .Description}},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.icns",
			"icons/icon.png"
		],
		"macOS": {
			"minimumSystemVersion": "13.0",
			"signingIdentity": "-"
		}
	}
}
