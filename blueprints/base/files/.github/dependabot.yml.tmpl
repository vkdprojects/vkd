version: 2
# cooldown: a new version waits 7 days before a PR, so a compromised or yanked release is usually caught
# upstream before it reaches us.
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: weekly }
    cooldown: { default-days: 7 }
    groups:
      actions:
        patterns: ["*"]
    commit-message: { prefix: "chore(ci)" }
