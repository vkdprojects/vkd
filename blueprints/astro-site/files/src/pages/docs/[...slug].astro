---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { docHref, sortDocs } from "../../lib/docs";

export async function getStaticPaths() {
	const docs = sortDocs(await getCollection("docs"));
	return docs.map((entry) => ({
		params: { slug: entry.id === "index" ? undefined : entry.id },
		props: { entry, docs },
	}));
}

const { entry, docs } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
	<main id="main">
		<nav aria-label="Docs">
			<ul class="doc-list">
				{docs.map((d) => <li><a href={docHref(d.id)} aria-current={d.id === entry.id ? "page" : undefined}>{d.data.title}</a></li>)}
			</ul>
		</nav>
		<article class="ca-prose">
			<h1>{entry.data.title}</h1>
			<Content />
		</article>
	</main>
</Base>
